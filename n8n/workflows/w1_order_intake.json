    {
      "parameters": {
        "jsCode": "// Turn the typed order lines into the list the database expects.\n// Each line must be:  quantity unit product   e.g. \"12 jugs hand soap\"\n\nconst form  = $('MetroSupply - New order').first().json;   // the form answers\nconst saved = $input.first().json;                     // {event_id, is_new} from \"Save message once\"\n\nconst lines = [];      // lines we could read\nconst problems = [];   // lines we could not read\n\nform['Order lines'].split('\\n').forEach((raw, i) => {\n  const text = raw.trim();\n  if (text === '') return;                                      // skip empty lines\n  const match = text.match(/^(\\d+(?:\\.\\d+)?)\\s+(\\S+)\\s+(.+)$/); // quantity, unit, product\n  if (!match) {\n    problems.push(`Line ${i + 1} \"${text}\": write it as  quantity unit product  (e.g. 12 jugs hand soap)`);\n    return;\n  }\n  lines.push({ qty: Number(match[1]), unit: match[2], product: match[3] });\n});\n\nreturn [{\n  json: {\n    event_id: saved.event_id,\n    is_new: saved.is_new,\n    customer_code: form['Customer code'].trim().toUpperCase(),\n    po_number: form['PO number'].trim(),\n    lines: JSON.stringify(lines),\n    line_count: lines.length,\n    problems,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -96
      ],
